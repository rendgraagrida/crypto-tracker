{
  "name": "frontend-pelacak",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "bot": "node --no-warnings --experimental-strip-types --env-file-if-exists=.env.local scripts/bot.ts",
    "trade:worker": "node --no-warnings --experimental-strip-types --env-file-if-exists=.env.trader.local scripts/trader.ts",
    "paper:replay": "node --no-warnings --experimental-strip-types scripts/paper-replay.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "test": "node --no-warnings --experimental-strip-types --test test/*.test.ts",
    "test:integration": "node --no-warnings --experimental-strip-types --test test/integration.test.ts",
    "test:all": "node --no-warnings --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "@supabase/supabase-js": "^2.112.3",
    "axios": "^1.19.0",
    "ethers": "^6.17.0",
    "lucide-react": "^1.33.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "technicalindicators": "^3.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
