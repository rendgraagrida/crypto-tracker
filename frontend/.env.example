# Existing product database. Use an isolated project first; apply the checked-in SQL migrations deliberately.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-scoped-server-service-role-key

# Native bot runtime: Node 24+, binds only 127.0.0.1. No Next/Docker required for bot:start.
BOT_PORT=3005
BOT_TRANSPORT=polling
BOT_API_TOKEN=replace-with-random-secret-at-least-32-characters
# Explicit origins for browser dashboard writes; do not derive trust from Host.
BOT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_ALLOWED_USER_IDS=your-numeric-telegram-user-id
TELEGRAM_ALLOWED_CHAT_IDS=your-numeric-private-or-approved-group-chat-id
TELEGRAM_CHAT_ID=your-numeric-alert-destination-chat-id
# Only needed in webhook mode, setWebhook remains an explicit operator action.
TELEGRAM_WEBHOOK_SECRET=replace-with-random-32-to-256-character-secret
SCAN_INTERVAL_SECONDS=300
MIN_WHALE_USD=100
ENABLE_COIN_SCANNER=false

# RPC providers remain quota-limited. Configure only networks actually used.
ALCHEMY_ETH_URL=https://eth-mainnet.g.alchemy.com/v2/your-api-key
ALCHEMY_BASE_URL=https://base-mainnet.g.alchemy.com/v2/your-api-key
ALCHEMY_BSC_URL=https://bnb-mainnet.g.alchemy.com/v2/your-api-key
ALCHEMY_SOL_URL=https://solana-mainnet.g.alchemy.com/v2/your-api-key
ALCHEMY_POLYGON_URL=
ALCHEMY_ARBITRUM_URL=
ALCHEMY_OPTIMISM_URL=
ALCHEMY_AVALANCHE_URL=
ALCHEMY_ROBINHOOD_URL=
HELIUS_API_KEY=
COVALENT_API_KEY=
JUPITER_API_KEY=

# Optional local Hermes through a loopback-only SSH reverse tunnel from the Mac.
# Leave empty to use deterministic reports without any AI call or cloud fallback.
HERMES_API_URL=
HERMES_MODEL=hermes-crypto-analyst
HERMES_AGENT_MODE=stateless
HERMES_TIMEOUT_MS=5000
# HERMES_AGENT_MODE=readonly_agent enables bounded 2-step read-only evidence inspection before JSON schema ranking.
# With approved tunnel, URL is http://127.0.0.1:11435/v1/chat/completions

# Paper is prospective virtual simulation only. No cost/actor/notional defaults are assumed.
PAPER_ENABLED=false
PAPER_OWNER_USER_ID=
PAPER_CHAT_ID=
PAPER_NOTIONAL_USD=
PAPER_ENTRY_FEE_USD=
PAPER_EXIT_FEE_USD=
PAPER_SLIPPAGE_BPS=
# Optional quote providers/public hot-wallet addresses, NEVER private keys in bot environment.
ZEROX_API_KEY=
TRADE_SOLANA_TAKER=
TRADE_EVM_TAKER=
# Isolated signer starts separately and remains OFF without its own .env.trader.local configuration.
