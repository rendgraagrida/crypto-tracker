# Supabase Database Connection
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# RPC Endpoints (Alchemy / Custom Providers)
ALCHEMY_ETH_URL=https://eth-mainnet.g.alchemy.com/v2/your-api-key
ALCHEMY_BSC_URL=https://bnb-mainnet.g.alchemy.com/v2/your-api-key
ALCHEMY_ROBINHOOD_URL=https://your-robinhood-chain-rpc
ALCHEMY_BASE_URL=https://base-mainnet.g.alchemy.com/v2/your-api-key
ALCHEMY_SOL_URL=https://solana-mainnet.g.alchemy.com/v2/your-api-key

# Third-Party APIs
HELIUS_API_KEY=your-helius-api-key
COVALENT_API_KEY=your-covalent-api-key
MORALIS_API_KEY=your-moralis-api-key

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Feature Toggles
ENABLE_COIN_SCANNER=true
