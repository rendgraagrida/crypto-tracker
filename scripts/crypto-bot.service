# Operator-reviewed example; not installed or enabled by this change.
[Unit]
Description=Crypto Tracker native Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=crypto-bot
Group=crypto-bot
WorkingDirectory=/opt/crypto-tracker
Environment=NODE_ENV=production
EnvironmentFile=/etc/crypto-bot.env
ExecStart=/usr/bin/node --no-warnings --experimental-strip-types /opt/crypto-tracker/frontend/scripts/bot.ts
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
UMask=0077
Nice=10
# Initial safety caps, not measured requirements. Review against Gomoku headroom before enabling.
MemoryHigh=384M
MemoryMax=512M
CPUQuota=50%
TasksMax=128

[Install]
WantedBy=multi-user.target
