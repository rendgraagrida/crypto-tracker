{
  "name": "crypto-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Crypto Tracker: native Telegram bot, deterministic analysis and optional local Hermes",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm --workspace frontend run bot",
    "local": "./local",
    "bot:start": "npm --workspace frontend run bot",
    "trade:worker": "npm --workspace frontend run trade:worker --",
    "paper:replay": "npm --workspace frontend run paper:replay --",
    "hermes:eval": "node --no-warnings --experimental-strip-types frontend/scripts/hermes-eval.ts",
    "release:pack": "node scripts/delivery.mjs pack",
    "release:deploy": "node scripts/delivery.mjs deploy",
    "release:rollback": "node scripts/delivery.mjs rollback",
    "release:status": "node scripts/delivery.mjs status",
    "release:stop": "node scripts/delivery.mjs stop",
    "db:bundle": "node scripts/database-bundle.mjs",
    "db:backup": "node scripts/database-backup.mjs",
    "dev:frontend": "npm --workspace frontend run dev",
    "build:frontend": "npm --workspace frontend run build",
    "start:frontend": "npm --workspace frontend run start",
    "test:frontend": "npm --workspace frontend test",
    "test:all": "npm --workspace frontend run test:all && node --test scripts/*.test.mjs",
    "check": "npm --workspace frontend run typecheck",
    "lint:frontend": "npm --prefix frontend run lint",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down"
  },
  "keywords": [
    "crypto",
    "tracker",
    "blockchain",
    "solana",
    "evm",
    "nextjs",
    "supabase"
  ],
  "author": "RendgraAgrida",
  "license": "ISC"
}
